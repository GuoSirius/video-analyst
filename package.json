{
  "name": "video-analyst",
  "version": "0.1.0",
  "description": "视频分析工具桌面应用",
  "author": "siriussupreme",
  "license": "MIT",
  "main": "dist-electron/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "vue-tsc -b && electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@element-plus/icons-vue": "^2.3.1",
    "electron-store": "^8.1.0",
    "element-plus": "^2.9.0",
    "fluent-ffmpeg": "^2.1.3",
    "pinia": "^2.3.0",
    "vue": "^3.5.32",
    "vue-i18n": "^10.0.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@unocss/reset": "^66.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "electron": "^36.0.0",
    "electron-vite": "^3.1.0",
    "sharp": "^0.34.5",
    "typescript": "~5.7.0",
    "unocss": "^66.0.0",
    "unplugin-auto-import": "^19.1.0",
    "unplugin-vue-components": "^28.4.0",
    "vite": "^6.2.0",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "build": {
    "appId": "com.videoanalyst.app",
    "productName": "Video Analyst",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "resources/**/*"
    ],
    "mac": {
      "icon": "resources/icons/icon.png",
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "resources/icons/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "linux": {
      "icon": "resources/icons/icon.png",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
