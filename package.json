{
  "name": "video-analyst",
  "version": "1.3.0",
  "description": "视频分析工具桌面应用",
  "author": "siriussupreme",
  "license": "MIT",
  "main": "dist-electron/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "cross-env NODE_ENV=production npm run lint && vue-tsc -b && electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "typecheck": "vue-tsc -b",
    "release": "standard-version",
    "release:major": "standard-version --release-as major",
    "release:minor": "standard-version --release-as minor",
    "release:patch": "standard-version --release-as patch",
    "push": "git push && git push --tags",
    "push:all": "git push origin main --tags && git push github main --tags",
    "release:push": "npm run release && npm run push:all",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@element-plus/icons-vue": "^2.3.2",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "element-plus": "^2.13.7",
    "fluent-ffmpeg": "^2.1.3",
    "pinia": "^2.3.1",
    "vue": "^3.5.33",
    "vue-i18n": "^11.4.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.17",
    "@unocss/reset": "^66.6.8",
    "@vitejs/plugin-vue": "^5.2.4",
    "cross-env": "^10.1.0",
    "electron": "^36.9.5",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.1.0",
    "eslint": "^10.2.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.9.0",
    "globals": "^17.5.0",
    "sharp": "^0.34.5",
    "standard-version": "^9.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.0",
    "unocss": "^66.6.8",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-vue-components": "^28.8.0",
    "vite": "^6.4.2",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^2.2.12"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
