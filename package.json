{
  "name": "video-analyst",
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"pnpm server\" \"pnpm web\"",
    "server": "pnpm --filter server dev",
    "web": "pnpm --filter web dev",
    "build": "pnpm --filter server build && pnpm --filter web build",
    "start": "pnpm --filter server start:prod",
    "preview": "pnpm build && pnpm start"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
