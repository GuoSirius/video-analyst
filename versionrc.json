{
  "types": [
    {"type": "feat", "section": "Features", "hidden": false},
    {"type": "fix", "section": "Bug Fixes", "hidden": false},
    {"type": "docs", "section": "Documentation", "hidden": true},
    {"type": "style", "section": "Styles", "hidden": true},
    {"type": "refactor", "section": "Code Refactoring", "hidden": false},
    {"type": "perf", "section": "Performance Improvements", "hidden": false},
    {"type": "test", "section": "Tests", "hidden": true},
    {"type": "build", "section": "Build System", "hidden": true},
    {"type": "ci", "section": "Continuous Integration", "hidden": true},
    {"type": "chore", "section": "Chores", "hidden": true},
    {"type": "revert", "section": "Reverts", "hidden": true}
  ],
  "commitUrlFormat": "https://gitee.com/{{owner}}/{{repository}}/commit/{{hash}}",
  "compareUrlFormat": "https://gitee.com/{{owner}}/{{repository}}/compare/{{previousTag}}...{{currentTag}}",
  "issueUrlFormat": "https://gitee.com/{{owner}}/{{repository}}/issues/{{id}}",
  "issuePrefixes": ["#"],
  "breakingChangePattern": "^BREAKING CHANGE:",
  "header": "# Changelog\n\nAll notable changes to this project will be documented in this file. See [standard-version](https://github.com/conventional-changelog/standard-version) for commit guidelines.",
  "releaseCommitMessageFormat": "chore(release): {{currentTag}}",
  "sortDir": "desc",
  "infile": "CHANGELOG.md",
  "skip": {
    "bump": false,
    "changelog": false,
    "commit": true,
    "tag": true
  }
}
