# FFmpeg 路径（可选，不填则使用系统 PATH 中的 ffmpeg）
FFMPEG_PATH=

# Whisper 服务地址（留空则使用本地 whisper CLI）
MEMO_AI_BASE_URL=

# 数据库加密密钥（可选，不设置使用默认值，建议生产环境设置）
ENCRYPTION_KEY=

# ========== 大模型 API 配置（初始导入用，之后可通过模型管理页面维护） ==========
# MiniMax
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 服务端口和绑定地址
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
WEB_PORT=5173

# 前端 API 请求地址（开发时指向后端，部署时可改为相对路径 /api）
VITE_API_BASE_URL=http://127.0.0.1:3000/api
